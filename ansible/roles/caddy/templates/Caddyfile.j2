{
{% if caddy_homepage_enabled %}
	admin 127.0.0.1:2019
	persist_config off
{% else %}
	admin off
{% endif %}
	acme_ca {{ caddy_acme_ca }}
	auto_https disable_redirects
	email {{ caddy_acme_email }}
}

*.home.{{ caddy_domain }} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
		resolvers 1.1.1.1 1.0.0.1
	}

	@gitea host {{ caddy_gitea_hostname }}
	handle @gitea {
		reverse_proxy {{ caddy_gitea_upstream }}
	}

	@adguard host {{ caddy_adguard_hostname }}
	handle @adguard {
		reverse_proxy {{ caddy_adguard_upstream }}
	}

	@hermes host {{ caddy_hermes_hostname }}
	handle @hermes {
		reverse_proxy {{ caddy_hermes_upstream }}
	}

	@inkling host {{ caddy_inkling_hostname }}
	handle @inkling {
		reverse_proxy {{ caddy_inkling_upstream }}
	}

{% if caddy_storage_enabled %}
	@s3 host {{ caddy_s3_hostname }}
	handle @s3 {
		# Preserve Host and path for S3 signature validation. No proxy Basic Auth.
		reverse_proxy {{ caddy_s3_upstream }}
	}
	@garage host {{ caddy_garage_hostname }}
	handle @garage {
		reverse_proxy {{ caddy_garage_upstream }}
	}
{% endif %}
	@wireguard host wireguard.home.{{ caddy_domain }}
	handle @wireguard {
		reverse_proxy http://{{ hostvars[groups['access'][0]].ansible_host }}:51821
	}

{% if caddy_homepage_enabled %}
	@homepage host {{ homepage_hostname }}
	handle @homepage {
		reverse_proxy homepage:3000 {
			header_up -Authorization
		}
	}
{% endif %}

	handle {
		respond "Unknown private service" 404
	}
}

{% if caddy_homepage_enabled %}
# Only the dedicated internal network can reach this listener. No admin writes.
http://{{ homepage_proxy_caddy_ip }}:2020 {
	bind {{ homepage_proxy_caddy_ip }}
	@upstreams {
		method GET
		path /reverse_proxy/upstreams
	}
	handle @upstreams {
		reverse_proxy 127.0.0.1:2019 {
			header_up Host 127.0.0.1:2019
			header_up Origin http://127.0.0.1:2019
		}
	}
	handle {
		respond "Not available" 404
	}
}
{% endif %}
