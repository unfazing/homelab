server:
  host: 0.0.0.0
  port: 8080
  environment: production
  # Keep a single UI upload bounded within its 256 MiB process budget.
  max_body_size: 33554432
  domain: {{ storage_ui_hostname | to_json }}
  protocol: https
  root_url: {{ ('https://' ~ storage_ui_hostname) | to_json }}
garage:
  endpoint: {{ ('https://' ~ storage_s3_hostname) | to_json }}
  region: {{ garage_region | to_json }}
  admin_endpoint: {{ garage_ui_garage_admin_endpoint | to_json }}
  admin_token: {{ storage_secrets.garage.admin_token | to_json }}
auth:
  jwt_private_key_path: /app/data/jwt-key.pem
  metrics_public: false
  admin:
    enabled: true
    username: {{ storage_secrets.garage.ui_username | to_json }}
    password: {{ storage_secrets.garage.ui_password | to_json }}
  token:
    enabled: false
  oidc:
    enabled: false
cors:
  enabled: true
  allowed_origins: [{{ ('https://' ~ storage_ui_hostname) | to_json }}]
  allowed_methods: [GET, POST, PUT, DELETE, OPTIONS]
  allowed_headers: [Origin, Content-Type, Accept, Authorization]
  allow_credentials: false
logging:
  level: error
  format: json
