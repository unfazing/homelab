metadata_dir = "/var/lib/garage/meta"
data_dir = "/var/lib/garage/data"
db_engine = "lmdb"
replication_factor = 1
consistency_mode = "consistent"
metadata_fsync = true
data_fsync = true
block_ram_buffer_max = "64MiB"
block_max_concurrent_reads = 4
block_max_concurrent_writes_per_request = 2
rpc_bind_addr = "0.0.0.0:3901"
rpc_public_addr = "{{ garage_container_address }}:3901"
rpc_secret_file = "/run/secrets/rpc_secret"

[s3_api]
s3_region = "{{ garage_region }}"
api_bind_addr = "0.0.0.0:3900"
public_endpoint = "https://{{ storage_s3_hostname }}"
public_endpoint_path_style = true

[admin]
api_bind_addr = "0.0.0.0:3903"
admin_token_file = "/run/secrets/admin_token"
metrics_token_file = "/run/secrets/metrics_token"
metrics_require_token = true
