{% for app in gitea_runner_app_contracts %}
{% for key in app.authorized_keys %}
restrict,command="/usr/local/libexec/homelab-deploy {{ app.name }}" {{ key }}
{% endfor %}
{% endfor %}
{% for launcher in gitea_runner_app_launchers | default([]) %}
restrict,command="{{ launcher.command }}" {{ launcher.public_key }}
{% endfor %}
