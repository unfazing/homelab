#!/usr/bin/env python3
"""Small Gitea issue/PR client; the token never appears in argv or output."""

import argparse
import json
import re
import sys
from pathlib import Path
from urllib import error, parse, request


API_BASE = "{{ hermes_git_api_base_url }}"
TOKEN_FILE = Path("/opt/data/secrets/gitea-api-token")


def repository_path(value):
    if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", value):
        raise argparse.ArgumentTypeError("repository must be owner/name")
    return "/".join(parse.quote(piece, safe="") for piece in value.split("/"))


def body_text(path):
    if path is None:
        return ""
    if path == "-":
        return sys.stdin.read()
    return Path(path).read_text(encoding="utf-8")


def api(method, path, payload=None):
    token = TOKEN_FILE.read_text(encoding="ascii").strip()
    if not re.fullmatch(r"[A-Za-z0-9_.-]{32,}", token):
        raise RuntimeError("The Gitea token file is invalid")
    data = None if payload is None else json.dumps(payload).encode("utf-8")
    call = request.Request(
        API_BASE + path,
        data=data,
        method=method,
        headers={
            "Authorization": "token " + token,
            "Accept": "application/json",
            "Content-Type": "application/json",
        },
    )
    try:
        with request.urlopen(call, timeout=15) as response:
            return json.load(response)
    except error.HTTPError as exc:
        # Deliberately omit response bodies: they can echo issue or PR text.
        raise RuntimeError(f"Gitea {method} {path} returned HTTP {exc.code}") from exc


def main():
    parser = argparse.ArgumentParser(description="Use the lab-agent identity with Gitea over private HTTPS")
    commands = parser.add_subparsers(dest="command", required=True)
    repo = commands.add_parser("repo", help="Check repository visibility and enabled features")
    repo.add_argument("repository", type=repository_path)
    issue = commands.add_parser("issue-create", help="Open an issue")
    issue.add_argument("repository", type=repository_path)
    issue.add_argument("--title", required=True)
    issue.add_argument("--body-file", help="UTF-8 file, or - for standard input")
    pull = commands.add_parser("pr-create", help="Open a pull request after pushing its head branch")
    pull.add_argument("repository", type=repository_path)
    pull.add_argument("--head", required=True)
    pull.add_argument("--base", default="main")
    pull.add_argument("--title", required=True)
    pull.add_argument("--body-file", help="UTF-8 file, or - for standard input")
    args = parser.parse_args()

    if args.command == "repo":
        details = api("GET", "/repos/" + args.repository)
        print(json.dumps({
            "full_name": details["full_name"],
            "html_url": details["html_url"],
            "has_issues": details["has_issues"],
            "has_pull_requests": details["has_pull_requests"],
            "permissions": details.get("permissions", {}),
        }, sort_keys=True))
    elif args.command == "issue-create":
        issue = api("POST", "/repos/" + args.repository + "/issues", {
            "title": args.title,
            "body": body_text(args.body_file),
        })
        print(issue["html_url"])
    elif args.command == "pr-create":
        pull = api("POST", "/repos/" + args.repository + "/pulls", {
            "head": args.head,
            "base": args.base,
            "title": args.title,
            "body": body_text(args.body_file),
        })
        print(pull["html_url"])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"Gitea request failed: {exc}", file=sys.stderr)
        sys.exit(1)
