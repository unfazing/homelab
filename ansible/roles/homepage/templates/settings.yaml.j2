title: Homelab Operations
description: Private operator dashboard
theme: dark
color: slate
headerStyle: clean
statusStyle: dot
hideVersion: false
layout:
  Infrastructure:
    style: column
    Physical hosts:
      style: row
      columns: 2
      useEqualHeights: true
    Virtual machines:
      style: row
      columns: 3
      useEqualHeights: true
{% if homepage_storage_enabled %}
    Storage:
      style: row
      columns: 2
      useEqualHeights: true
{% endif %}
    Storage & activity:
      style: row
      columns: 2
      useEqualHeights: true
      initiallyCollapsed: true
  Network:
    style: row
    columns: 1
  Development & AI:
    style: row
    columns: 3
