@@ -0,0 +1,64 @@
+---
+- name: Validate the interim boundary profile
+  ansible.builtin.assert:
+    that: security_boundary_profile in ['agents', 'proxmox']
+- name: Install nftables
+  ansible.builtin.apt:
+    name: nftables
+    state: present
+- name: Create the security configuration directory
+  ansible.builtin.file:
+    path: /etc/homelab/security
+    state: directory
+    owner: root
+    group: root
+    mode: '0750'
+- name: Render the narrowly owned management boundary
+  ansible.builtin.template:
+    src: boundary.nft.j2
+    dest: /etc/homelab/security/management-boundary.nft
+    owner: root
+    group: root
+    mode: '0640'
+  register: security_boundary_rules
+- name: Validate boundary rules before activation
+  ansible.builtin.command: nft --check --file /etc/homelab/security/management-boundary.nft
+  changed_when: false
+  when: not ansible_check_mode
+- name: Install the persistent boundary unit
+  ansible.builtin.template:
+    src: management-boundary.service.j2
+    dest: /etc/systemd/system/homelab-management-boundary.service
+    owner: root
+    group: root
+    mode: '0644'
+  register: security_boundary_unit
+- name: Activate the management boundary
+  ansible.builtin.systemd_service:
+    name: homelab-management-boundary.service
+    daemon_reload: true
+    enabled: true
+    state: "{{ 'restarted' if security_boundary_rules.changed or security_boundary_unit.changed else 'started' }}"
+  when: not ansible_check_mode
+- name: Create the Docker dependency directory on the agent VM
+  ansible.builtin.file:
+    path: /etc/systemd/system/docker.service.d
+    state: directory
+    mode: '0755'
+  when: security_boundary_profile == 'agents'
+- name: Require the agent boundary before Docker starts
+  ansible.builtin.copy:
+    dest: /etc/systemd/system/docker.service.d/20-homelab-management-boundary.conf
+    content: |
+      [Unit]
+      Requires=homelab-management-boundary.service
+      After=homelab-management-boundary.service
+    owner: root
+    group: root
+    mode: '0644'
+  register: security_boundary_dependency
+  when: security_boundary_profile == 'agents'
+- name: Load Docker's dependency without restarting containers
+  ansible.builtin.systemd_service:
+    daemon_reload: true
+  when: security_boundary_dependency.changed | default(false)
diff --git a/ansible/roles/security-boundary/templates/boundary.nft.j2 b/ansible/roles/security-boundary/templates/boundary.nft.j2
new file mode 100644
index 0000000..a266a99
--- /dev/null
+++ b/ansible/roles/security-boundary/templates/boundary.nft.j2
@@ -0,0 +1,33 @@
+{% if security_boundary_profile == 'agents' %}
+destroy table inet homelab_agent_egress
+table inet homelab_agent_egress {
+    chain protect_management {
+        # Permit replies to management connections initiated toward this VM.
+        ct state established,related accept
+        # Preserve existing router DNS while denying its management interfaces.
+        ip daddr 192.168.1.254 udp dport 53 accept
+        ip daddr 192.168.1.254 tcp dport 53 accept
+        ip daddr { 192.168.1.10, 192.168.1.254 } counter drop
+        # Inkling is the only approved legacy-host workload path.
+        ip daddr 192.168.1.9 tcp dport 3000 accept
+        ip daddr 192.168.1.9 counter drop
+    }
+    chain forwarded {
+        type filter hook prerouting priority -150; policy accept;
+        jump protect_management
+    }
+    chain local {
+        type filter hook output priority -150; policy accept;
+        jump protect_management
+    }
+}
+{% else %}
+destroy table inet homelab_agent_management
+table inet homelab_agent_management {
+    chain input {
+        type filter hook input priority -20; policy accept;
+        ct state established,related accept
+        ip saddr 192.168.1.102 counter drop
+    }
+}
+{% endif %}
diff --git a/ansible/roles/security-boundary/templates/management-boundary.service.j2 b/ansible/roles/security-boundary/templates/management-boundary.service.j2
new file mode 100644
index 0000000..2d5daa7
--- /dev/null
+++ b/ansible/roles/security-boundary/templates/management-boundary.service.j2
@@ -0,0 +1,16 @@
+[Unit]
+Description=Homelab interim agent management boundary
+DefaultDependencies=no
+After=local-fs.target
+Before=network-pre.target docker.service shutdown.target
+Conflicts=shutdown.target
+Wants=network-pre.target
+
+[Service]
+Type=oneshot
+ExecStart=/usr/sbin/nft -f /etc/homelab/security/management-boundary.nft
+ExecReload=/usr/sbin/nft -f /etc/homelab/security/management-boundary.nft
+RemainAfterExit=yes
+
+[Install]
+WantedBy=multi-user.target
