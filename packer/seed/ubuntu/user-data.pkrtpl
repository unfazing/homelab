#cloud-config
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: ubuntu
    username: packer
    password: '*'
  network:
    version: 2
    ethernets:
      id0:
        match:
          driver: virtio*
        dhcp4: true
  storage:
    layout:
      name: direct
  packages:
    - qemu-guest-agent
  ssh:
    install-server: true
    allow-pw: false
    authorized-keys:
      - __PACKER_SSH_PUBLIC_KEY__
  late-commands:
    - curtin in-target --target=/target -- apt update
    - curtin in-target --target=/target -- apt upgrade -y
    - curtin in-target --target=/target -- sh -c "echo 'packer ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/packer"
    - curtin in-target --target=/target -- chmod 0440 /etc/sudoers.d/packer
